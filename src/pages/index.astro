---
import '../styles/global.css';
import Drawing from '../components/Drawing.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, hero, about, services, contact } from '../content';

// Separator before item i of a list: "a, b and c".
const sep = (i: number, n: number) => (i === 0 ? '' : i === n - 1 ? ' and ' : ', ');
const { lede } = hero;
// Each sentence of the headline starts on its own line, and hyphenated words
// like "enterprise-grade" never split across lines.
const headlineSentences = hero.headline.split(/(?<=\.)\s+/).map((s) => s.split(' '));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500&family=Schibsted+Grotesk:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="site-header wrap">
      <a class="wordmark" href="#top" aria-label={`${site.name}, back to top`}>
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <!-- 3×3 node grid: the L in ink, unused nodes faint, one node lit in accent -->
          <path class="mark-link" d="M6 6V26H26" />
          <circle cx="6" cy="6" r="3.6" /><circle cx="6" cy="16" r="3.6" /><circle cx="6" cy="26" r="3.6" />
          <circle cx="16" cy="26" r="3.6" /><circle cx="26" cy="26" r="3.6" />
          <circle class="mark-faint" cx="16" cy="6" r="2.4" /><circle class="mark-faint" cx="16" cy="16" r="2.4" />
          <circle class="mark-faint" cx="26" cy="16" r="2.4" />
          <circle class="mark-lit" cx="26" cy="6" r="3.6" />
        </svg>
        {site.name}
      </a>
      <nav aria-label="Sections">
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero wrap">
        <div class="hero-text">
          <h1>
            {headlineSentences.map((words) => (
              <span class="sentence">
                {words.map((w, i) => (
                  <>{i > 0 && ' '}{w.includes('-') ? <span class="nowrap">{w}</span> : w}</>
                ))}
              </span>
            ))}
          </h1>
          <p class="lede">
            {lede.lead}{' '}
            {lede.services.map((x, i) => <>{sep(i, lede.services.length)}<strong>{x}</strong></>)}.{' '}
            {lede.languagesLead}{' '}
            {lede.languages.map((x, i) => <>{sep(i, lede.languages.length)}<code>{x}</code></>)}.
          </p>
          <div class="actions">
            <a class="button" href="#contact">{hero.cta}</a>
            <a class="text-link" href="#services">See what we build</a>
          </div>
        </div>
        <div class="hero-drawing">
          <Drawing />
        </div>
      </section>

      <section id="about" class="block wrap" aria-labelledby="about-heading">
        <h2 id="about-heading">{about.heading}</h2>
        <div class="about-body">
          {about.body.map((p) => <p>{p}</p>)}
        </div>
        <dl class="facts">
          {about.facts.map((f) => (
            <div>
              <dt>{f.term}</dt>
              <dd>{f.detail}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="services" class="block wrap" aria-labelledby="services-heading">
        <h2 id="services-heading">{services.heading}</h2>
        <div class="spec">
          <div class="spec-row spec-head" aria-hidden="true">
            {services.columns.map((c) => <span>{c}</span>)}
          </div>
          <ul>
            {services.items.map((s) => (
              <li class="spec-row">
                <h3>{s.name}</h3>
                <p>{s.detail}</p>
                <p class="outcome"><span class="visually-hidden">{services.columns[2]}: </span>{s.outcome}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="contact" class="block contact wrap" aria-labelledby="contact-heading">
        <h2 id="contact-heading">{contact.heading}</h2>
        <div class="contact-body">
          <p>{contact.body}</p>
          <ContactForm />
          <div class="direct">
            <p>Prefer to write directly?</p>
            <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
            <a class="text-link" href={site.callUrl}>{contact.secondary}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer wrap">
      <p>{site.location ? `${site.name}, ${site.location}` : site.name}</p>
      <p>© {new Date().getFullYear()}</p>
    </footer>
  </body>
</html>

<style>
  /* Header */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--step-2);
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .wordmark svg {
    width: 1.375rem;
    height: 1.375rem;
    fill: var(--ink);
  }
  .wordmark .mark-link {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }
  .wordmark .mark-faint {
    fill: var(--rule);
  }
  .wordmark .mark-lit {
    fill: var(--accent);
  }
  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    font-size: var(--step-0);
  }
  nav a {
    text-decoration: none;
    color: var(--lead);
  }
  nav a:hover {
    color: var(--ink);
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 3rem;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(4rem, 9vw, 7rem);
  }
  .hero-text {
    grid-column: 1 / span 7;
  }
  .hero-drawing {
    grid-column: 8 / span 5;
  }
  h1 {
    font-size: clamp(var(--step-3), 3.6vw + 0.5rem, 3.25rem);
    line-height: 1.08;
    max-width: 20ch;
  }
  h1 .sentence {
    display: block;
  }
  h1 .nowrap {
    white-space: nowrap;
  }
  .lede {
    margin-top: 1.75rem;
    max-width: 30rem;
    color: var(--lead);
    font-size: var(--step-2);
    line-height: 1.6;
  }
  .lede strong {
    color: var(--ink);
    font-weight: 500;
  }
  .lede code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--ink);
    background: var(--wash);
    padding: 0.15em 0.45em;
    border-radius: 3px;
    white-space: nowrap;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2.25rem;
  }
  .text-link {
    font-size: var(--step-0);
    font-weight: 500;
  }
  .text-link:hover {
    color: var(--accent);
  }

  /* Shared section frame */
  .block {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 2rem;
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--rule);
  }
  .block h2 {
    grid-column: 1 / span 4;
    font-size: var(--step-3);
    line-height: 1.2;
    max-width: 16ch;
  }

  /* About */
  .about-body {
    grid-column: 5 / span 5;
    display: grid;
    gap: 1.1em;
    align-content: start;
    max-width: 36rem;
  }
  .facts {
    grid-column: 10 / span 3;
    margin: 0;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .facts dt {
    font-size: var(--step-0);
    color: var(--lead);
  }
  .facts dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--step-0);
    line-height: 1.45;
  }

  /* Services spec table */
  .spec {
    grid-column: 1 / -1;
  }
  .spec ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .spec-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .spec-row > :nth-child(1) { grid-column: 1 / span 4; }
  .spec-row > :nth-child(2) { grid-column: 5 / span 5; max-width: 36rem; }
  .spec-row > :nth-child(3) { grid-column: 10 / span 3; }
  .spec-head {
    padding-block: 0 0.75rem;
    font-size: var(--step-0);
    color: var(--lead);
  }
  .spec h3 {
    font-size: var(--step-2);
    line-height: 1.3;
  }
  .spec .outcome {
    font-size: var(--step-0);
    line-height: 1.5;
  }

  /* Contact */
  .contact-body {
    grid-column: 5 / span 8;
    max-width: 40rem;
  }
  .direct {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .direct p {
    flex-basis: 100%;
    font-size: var(--step-0);
    color: var(--lead);
  }
  .email {
    font-family: var(--font-mono);
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    overflow-wrap: anywhere;
  }
  .email:hover {
    color: var(--accent);
  }

  /* Footer */
  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step-0);
    color: var(--lead);
  }

  @media (max-width: 56rem) {
    .hero-text,
    .hero-drawing {
      grid-column: 1 / -1;
    }
    .hero-drawing {
      max-width: 34rem;
    }
    .block h2,
    .about-body,
    .contact-body {
      grid-column: 1 / -1;
    }
    .facts {
      grid-column: 1 / -1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .spec-head {
      display: none;
    }
    .spec-row {
      grid-template-columns: 1fr;
      row-gap: 0.5rem;
    }
    .spec-row > :nth-child(n) { grid-column: 1; }
    .spec-row > :nth-child(3) { color: var(--lead); }
  }

  @media (max-width: 30rem) {
    nav { gap: 0.875rem; }
    .facts { grid-template-columns: 1fr; }
  }
</style>
