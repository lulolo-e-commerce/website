---
import '../styles/global.css';
import Drawing from '../components/Drawing.astro';
import ContactForm from '../components/ContactForm.astro';
import AboutDiagram from '../components/AboutDiagram.astro';
import { site, hero, pricing, about, services, contact, euros, planLabel } from '../content';

// Separator before item i of a list: "a, b and c" (or "a, b or c").
const sep = (i: number, n: number, last = 'and') => (i === 0 ? '' : i === n - 1 ? ` ${last} ` : ', ');
const { lede } = hero;
const { vps, points } = pricing;
// Each sentence of the headline starts on its own line, and hyphenated words
// like "enterprise-grade" never split across lines.
const headlineSentences = hero.headline.split(/(?<=\.)\s+/).map((s) => s.split(' '));

const pageUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const ogImage = new URL('og.png', pageUrl).href;
// Structured data so search engines know who the site belongs to and what it offers.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${pageUrl}#organization`,
      name: site.name,
      url: pageUrl,
      logo: new URL('favicon.svg', pageUrl).href,
      email: site.email,
      description: site.description,
      knowsAbout: [...lede.services, ...services.languages],
      makesOffer: [
        {
          '@type': 'Offer',
          name: `VPS ${vps.name}`,
          description: `${vps.name}, ${vps.highlight}`,
          price: vps.price.replace(/[^\d.]/g, ''),
          priceCurrency: 'EUR',
        },
        ...points.cards.map((c) => ({
          '@type': 'Offer',
          name: `${c.points} engineer points`,
          price: String(c.price),
          priceCurrency: 'EUR',
        })),
        ...services.items.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.name, description: s.detail },
        })),
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${pageUrl}#website`,
      name: site.name,
      url: pageUrl,
      publisher: { '@id': `${pageUrl}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#ffffff" />

    <!-- Link previews (LinkedIn, Slack, X, iMessage, ...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${hero.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="#top" aria-label={`${site.name}, back to top`}>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <!-- 3×3 node grid: the L in ink, unused nodes faint, one node lit in accent -->
            <path class="mark-link" d="M6 6V26H26" />
            <circle cx="6" cy="6" r="3.6" /><circle cx="6" cy="16" r="3.6" /><circle cx="6" cy="26" r="3.6" />
            <circle cx="16" cy="26" r="3.6" /><circle cx="26" cy="26" r="3.6" />
            <circle class="mark-faint" cx="16" cy="6" r="2.4" /><circle class="mark-faint" cx="16" cy="16" r="2.4" />
            <circle class="mark-faint" cx="26" cy="16" r="2.4" />
            <circle class="mark-lit" cx="26" cy="6" r="3.6" />
          </svg>
          {site.name}
        </a>
        <nav aria-label="Sections">
          <a href="#pricing">Pricing</a>
          <a href="#about">How it works</a>
          <a href="#services">Services</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="band hero" aria-labelledby="hero-heading">
        <div class="wrap">
          <div class="hero-text" data-reveal>
            <span class="eyebrow">{hero.eyebrow}</span>
            <h1 id="hero-heading">
              {headlineSentences.map((words) => (
                <span class="sentence">
                  {words.map((w, i) => (
                    <>{i > 0 && ' '}{w.includes('-') ? <span class="nowrap">{w}</span> : w}</>
                  ))}
                </span>
              ))}
            </h1>
            <p class="lede">
              {lede.lead} <strong>{lede.price}</strong>.{' '}
              {lede.middle}{' '}
              {lede.services.map((x, i) => <>{sep(i, lede.services.length, 'or')}<strong>{x}</strong></>)}.
            </p>
            <div class="actions">
              <a class="button" href="#pricing">{hero.cta}</a>
              <a class="text-link" href="#contact">{hero.more}</a>
            </div>
          </div>
          <div class="hero-drawing">
            <Drawing />
          </div>
        </div>
      </section>

      <section id="pricing" class="band block pricing" aria-labelledby="pricing-heading">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <span class="eyebrow">{pricing.eyebrow}</span>
            <h2 id="pricing-heading">{pricing.heading}</h2>
          </div>

          <div class="price-group">
            <div class="price-group-head" data-reveal>
              <h3>{vps.heading}</h3>
              <p>{vps.body}</p>
            </div>
            <div class="price-card featured vps-offer">
              <div>
                <h4><span class="vps-start">{vps.start}</span> {vps.name}, <span class="vps-highlight">{vps.highlight}</span></h4>
                <p class="price">{vps.priceLead} <span class="amount">{vps.price}</span> {vps.period}</p>
              </div>
              <a class="button" href="#contact" data-plan={planLabel.vps}>{vps.choose}</a>
            </div>
          </div>

          <div class="price-group">
            <div class="price-group-head" data-reveal>
              <h3>{points.heading}</h3>
              <p>{points.body}</p>
            </div>
            <ul class="price-cards">
              {points.cards.map((c) => (
                <li class="price-card">
                  <h4>{c.points} points</h4>
                  <p class="price"><span class="amount">{euros(c.price)}</span></p>
                  <p class="per-point">{euros(c.price / c.points)} {points.perPoint}</p>
                  <a class="button quiet" href="#contact" data-plan={planLabel.points(c)}>
                    {points.choose} {c.points} points
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="about" class="band band-alt block" aria-labelledby="about-heading">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <span class="eyebrow">{about.eyebrow}</span>
            <h2 id="about-heading">{about.heading}</h2>
          </div>
          <ol class="chapters">
            {about.chapters.map((c, i) => (
              <li class="chapter" style={`--row: ${i + 1}`}>
                <div class="chapter-text">
                  <span class="chapter-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{c.title}</h3>
                  <p>{c.body}</p>
                </div>
                <AboutDiagram kind={c.diagram} label={c.label} notes={c.notes} />
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="services" class="band band-dark block" aria-labelledby="services-heading">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <span class="eyebrow">{services.eyebrow}</span>
            <h2 id="services-heading">{services.heading}</h2>
            <p class="section-lede">
              {services.languagesLead}{' '}
              {services.languages.map((x, i) => <>{sep(i, services.languages.length)}<code>{x}</code></>)}.
            </p>
          </div>
          <svg class="defs" width="0" height="0" aria-hidden="true">
            <defs>
              <linearGradient id="tile-orb" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#40a9ff" />
                <stop offset="1" stop-color="#5e5ce6" />
              </linearGradient>
            </defs>
          </svg>
          <ul class="tiles">
            {services.items.map((s) => (
              <li class="tile">
                <svg class="tile-icon" viewBox="0 0 48 48" aria-hidden="true">
                  {s.icon === 'app' && (
                    <>
                      <rect x="5" y="9" width="38" height="30" rx="4" />
                      <line x1="5" y1="16" x2="43" y2="16" />
                      <circle class="dot" cx="9.5" cy="12.5" r="1.2" />
                      <line class="soft" x1="11" y1="23" x2="27" y2="23" />
                      <line class="soft" x1="11" y1="29" x2="35" y2="29" />
                    </>
                  )}
                  {s.icon === 'pipeline' && (
                    <>
                      <rect x="4" y="18" width="10" height="12" rx="2" />
                      <rect x="19" y="18" width="10" height="12" rx="2" />
                      <rect class="fill" x="34" y="18" width="10" height="12" rx="2" />
                      <line class="soft" x1="14" y1="24" x2="19" y2="24" />
                      <line class="soft" x1="29" y1="24" x2="34" y2="24" />
                    </>
                  )}
                  {s.icon === 'agent' && (
                    <>
                      <circle class="fill" cx="24" cy="24" r="8" />
                      <circle class="soft" cx="24" cy="24" r="16" stroke-dasharray="3 4" />
                      <circle class="dot" cx="24" cy="24" r="2" />
                    </>
                  )}
                  {s.icon === 'idea' && (
                    <>
                      <rect class="soft" x="7" y="7" width="34" height="34" rx="8" stroke-dasharray="3 4" />
                      <circle class="fill" cx="24" cy="24" r="8" />
                      <line class="plus" x1="24" y1="20" x2="24" y2="28" />
                      <line class="plus" x1="20" y1="24" x2="28" y2="24" />
                    </>
                  )}
                </svg>
                <h3>{s.name}</h3>
                <p class="tile-detail">{s.detail}</p>
                <p class="tile-outcome">
                  <span class="eyebrow">{services.outcomeLabel}</span>
                  {s.outcome}
                </p>
                {s.cta && <a class="text-link tile-cta" href="#contact">{s.cta}</a>}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="contact" class="band block contact" aria-labelledby="contact-heading">
        <div class="wrap">
          <div class="section-head" data-reveal>
            <span class="eyebrow">{contact.eyebrow}</span>
            <h2 id="contact-heading">{contact.heading}</h2>
            <p class="section-lede">{contact.body}</p>
          </div>
          <div class="contact-panel band-alt" data-reveal>
            <ContactForm />
            <div class="direct">
              <p>Prefer to write directly?</p>
              <a class="email" href={`mailto:${site.email}`} aria-label={site.email}>{site.email}</a>
              <a class="text-link" href={site.callUrl}>{contact.secondary}</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="band band-alt site-footer">
      <div class="wrap footer-inner">
        <p>{site.location ? `${site.name}, ${site.location}` : site.name}</p>
        <nav aria-label="Footer">
          <a href="#pricing">Pricing</a>
          <a href="#about">How it works</a>
          <a href="#services">Services</a>
          <a href="#contact">Contact</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </nav>
        <p>© {new Date().getFullYear()}</p>
      </div>
    </footer>
  </body>
</html>

<script>
  import gsap from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrambleTextPlugin } from 'gsap/ScrambleTextPlugin';

  gsap.registerPlugin(DrawSVGPlugin, ScrollTrigger, ScrambleTextPlugin);

  // Header: show its bottom rule once the page has scrolled.
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const markScrolled = () => header.classList.toggle('is-scrolled', window.scrollY > 4);
  markScrolled();
  window.addEventListener('scroll', markScrolled, { passive: true });

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', (context) => {
    // Wordmark: on hover, redraw the L through its nodes, then pulse the lit node.
    // The line reaches a node every 0.125s, so the nodes pop as it passes.
    const mark = document.querySelector<HTMLElement>('.wordmark')!;
    const markTl = gsap
      .timeline({ paused: true, defaults: { immediateRender: false, transformOrigin: '50% 50%' } })
      .fromTo(mark.querySelector('.mark-link'), { drawSVG: '0%' }, { drawSVG: '100%', duration: 0.5, ease: 'none' })
      .fromTo(mark.querySelectorAll('circle:not([class])'), { scale: 0.4 },
        { scale: 1, duration: 0.3, ease: 'back.out(3)', stagger: 0.125 }, 0)
      .fromTo(mark.querySelector('.mark-lit'), { scale: 1 },
        { scale: 1.35, duration: 0.18, ease: 'power1.out', yoyo: true, repeat: 1 });
    const playMark = () => markTl.isActive() || markTl.restart();
    mark.addEventListener('mouseenter', playMark);

    // Headings and service tiles fade up as they scroll into view. Triggers are
    // measured after load, once styles and fonts have settled the layout.
    const reveals = gsap.utils.toArray<HTMLElement>('[data-reveal]:not(.hero-text)');
    const tiles = gsap.utils.toArray<HTMLElement>('.tile, .price-card');
    gsap.set([...reveals, ...tiles], { opacity: 0, y: 32 });
    const rise = { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out' };
    const watch = context.add(() => {
      ScrollTrigger.batch(reveals, { start: 'top 85%', once: true, onEnter: (batch) => gsap.to(batch, rise) });
      ScrollTrigger.batch(tiles, { start: 'top 88%', once: true, onEnter: (batch) => gsap.to(batch, { ...rise, stagger: 0.1 }) });

      // The hero drawing recedes as the page scrolls past it.
      gsap.to('.hero-drawing', {
        opacity: 0.25,
        scale: 0.96,
        ease: 'none',
        scrollTrigger: { trigger: '.hero-drawing', start: 'center 45%', end: 'bottom top', scrub: true },
      });
    });
    if (document.readyState === 'complete') watch();
    else window.addEventListener('load', watch, { once: true });

    // The hero text rises in on load.
    gsap.from('.hero-text > *', { opacity: 0, y: 24, duration: 1, ease: 'power3.out', stagger: 0.08 });

    // Email: scramble back into place on hover. The link's aria-label keeps its
    // accessible name stable while the text changes.
    const email = document.querySelector<HTMLElement>('.email')!;
    const address = email.textContent!;
    const scrambleEmail = () =>
      gsap.isTweening(email) ||
      gsap.to(email, { duration: 0.6, scrambleText: { text: address, chars: 'lowerCase', speed: 0.6 } });
    email.addEventListener('mouseenter', scrambleEmail);

    return () => {
      mark.removeEventListener('mouseenter', playMark);
      email.removeEventListener('mouseenter', scrambleEmail);
      window.removeEventListener('load', watch);
    };
  });
</script>

<style>
  /* Header: a thin translucent bar that stays on top. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 78%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease-out);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--rule);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .wordmark svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: var(--ink);
  }
  .wordmark .mark-link {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }
  .wordmark .mark-faint {
    fill: var(--rule);
  }
  .wordmark .mark-lit {
    fill: var(--accent);
  }
  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
    font-size: 0.8125rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--ink);
    opacity: 0.8;
    transition: opacity 0.2s var(--ease-out);
  }
  nav a:hover {
    opacity: 1;
  }

  /* Hero: centered, very large type, the drawing underneath. */
  .hero {
    padding-block: clamp(4rem, 10vw, 8rem) clamp(2rem, 4vw, 3rem);
    text-align: center;
    overflow: hidden;
  }
  h1 {
    margin-top: 1rem;
    margin-inline: auto;
    max-width: 14ch;
    font-size: clamp(2.75rem, 7vw + 0.5rem, 6rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  h1 .sentence {
    display: block;
  }
  h1 .nowrap {
    white-space: nowrap;
  }
  .lede {
    margin: 1.5rem auto 0;
    max-width: 40rem;
    color: var(--lead);
    font-size: clamp(var(--step-2), 0.8vw + 1rem, 1.5rem);
    line-height: 1.4;
  }
  .lede strong {
    color: var(--ink);
    font-weight: 500;
  }
  .lede code,
  .section-lede code {
    font-family: var(--font-mono);
    font-size: 0.75em;
    color: var(--ink);
    background: var(--surface);
    padding: 0.2em 0.55em;
    border-radius: 0.5em;
    white-space: nowrap;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2.25rem;
  }
  /* The hero diagram on a grey dot-grid canvas, like a product shot. */
  .hero-drawing {
    max-width: 60rem;
    margin: clamp(3.5rem, 8vw, 5.5rem) auto 0;
    padding: clamp(1.5rem, 5vw, 3.5rem) clamp(1rem, 6vw, 5.5rem);
    text-align: left;
    background-color: var(--surface);
    background-image: radial-gradient(circle, rgb(0 0 0 / 0.09) 1px, transparent 1.5px);
    background-size: 22px 22px;
    background-position: center;
    border-radius: clamp(1.25rem, 3vw, 2rem);
  }

  /* Shared section frame */
  .block {
    padding-block: clamp(5rem, 12vw, 9rem);
  }
  .section-head {
    max-width: 48rem;
    margin: 0 auto clamp(3rem, 7vw, 5rem);
    text-align: center;
  }
  .section-head h2 {
    margin-top: 0.75rem;
    font-size: clamp(2.25rem, 4.5vw + 0.5rem, var(--step-6));
    line-height: 1.06;
    letter-spacing: -0.03em;
  }
  .section-lede {
    margin: 1.25rem auto 0;
    max-width: 36rem;
    font-size: var(--step-2);
    line-height: 1.45;
    color: var(--lead);
  }

  /* Pricing: one wide VPS offer, then engineer points, three cards per row. */
  .price-group + .price-group {
    margin-top: clamp(4rem, 9vw, 6rem);
  }
  .price-group-head {
    max-width: 40rem;
    margin: 0 auto 2rem;
    text-align: center;
  }
  .price-group-head h3 {
    font-size: var(--step-4);
    line-height: 1.1;
  }
  .price-group-head p {
    margin-top: 0.75rem;
    color: var(--lead);
  }
  .price-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .price-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: var(--surface);
    border-radius: 1.5rem;
    box-shadow: inset 0 0 0 2px transparent;
  }
  .price-card.featured {
    box-shadow: inset 0 0 0 2px var(--button);
  }
  .price-card h4 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
  }
  .price {
    margin-top: 0.75rem;
    color: var(--lead);
  }
  .price .amount {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .per-point {
    margin-top: 0.25rem;
    color: var(--lead);
  }
  .specs {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--rule);
  }
  .specs,
  .per-point {
    margin-bottom: 2rem;
  }
  .price-card .button {
    margin-top: auto;
  }
  .price-card.vps-offer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14rem;
    gap: 2rem clamp(2rem, 5vw, 4rem);
    align-items: center;
    max-width: 60rem;
    margin-inline: auto;
  }
  .vps-start {
    font-weight: 400;
    color: var(--lead);
  }
  .vps-highlight {
    color: var(--accent);
  }
  @media (max-width: 56rem) {
    .price-card.vps-offer {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Secondary buttons: accent text on a pale wash. */
  .button.quiet {
    background: var(--wash);
    color: var(--accent);
  }
  .button.quiet:hover {
    background: color-mix(in srgb, var(--wash) 85%, var(--accent));
  }

  /* About: text and diagram side by side, alternating sides. On wide screens
