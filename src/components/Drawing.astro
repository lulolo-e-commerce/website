---
// Hero drawing: the three specialities as one system, drawn like a technical
// diagram. Sources feed a data pipeline, the pipeline feeds a web app, and an
// AI agent works across both, all running on a server we host.
import { hero } from '../content';

const sources = [140, 185, 230];
const stages = [110, 157, 203];
const rows = [160, 185, 210, 235, 260, 285];
// Placeholder "cell text" per row: [x1, x2] pairs, varied so it reads as data.
const cells = [
  [[304, 340], [356, 410], [440, 474]],
  [[304, 332], [356, 424], [440, 468]],
  [[304, 344], [356, 400], [440, 476]],
  [[304, 326], [356, 418], [440, 462]],
  [[304, 338], [356, 406], [440, 472]],
];
// Routes for the flow animation, in SVG units: each source through the pipeline
// into the app, then the agent reading from the pipeline and acting in the app.
const sourceRoutes = ['M84,155 L110,194 L118,200 H289', 'M84,200 H289', 'M84,245 L110,206 L118,200 H289'];
const readRoute = 'M180,220 L185,301';
const actRoute = 'M223,312 L290,285';
// Server rack in the bottom-left corner: one row per slot, the middle one lit.
const slots = [296, 320, 344];
const { pipeline, app, agent, hosting } = hero.drawing;
---

<figure class="drawing" aria-label="Diagram: data sources feed a data pipeline, which feeds a web application. An AI agent works across both, and everything runs on a hosted server.">
  <svg viewBox="0 0 520 420" aria-hidden="true">
    <defs>
      <linearGradient id="hero-orb" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#40a9ff" />
        <stop offset="1" stop-color="#5e5ce6" />
      </linearGradient>
      <radialGradient id="hero-glow">
        <stop offset="0" stop-color="#0071e3" stop-opacity="0.3" />
        <stop offset="1" stop-color="#0071e3" stop-opacity="0" />
      </radialGradient>
    </defs>
    <g class="stroke frame">
      <!-- data sources -->
      {sources.map((y) => <rect x="20" y={y} width="64" height="30" rx="6" pathLength="1" />)}
      <!-- pipeline with three stages -->
      <rect x="110" y="180" width="140" height="40" rx="8" pathLength="1" />
      <line x1="157" y1="180" x2="157" y2="220" pathLength="1" />
      <line x1="203" y1="180" x2="203" y2="220" pathLength="1" />
      <!-- web app window -->
      <rect x="290" y="90" width="200" height="220" rx="10" pathLength="1" />
      <line x1="290" y1="112" x2="490" y2="112" pathLength="1" />
      <!-- server rack -->
      <rect x="20" y={slots[0]} width="96" height="72" rx="8" pathLength="1" />
      {slots.slice(1).map((y) => <line x1="20" y1={y} x2="116" y2={y} pathLength="1" />)}
    </g>

    <!-- highlight behind the app row being updated (animated) -->
    <rect class="fx-row" x="302" y={rows[0]} width="176" height="25"
      data-rows={JSON.stringify(rows.slice(0, cells.length))} />

    <g class="stroke content">
      {sources.map((y) => <line class="text" x1="30" y1={y + 15} x2="66" y2={y + 15} pathLength="1" />)}
      <!-- flow: sources into pipeline -->
      <line class="flow" x1="84" y1="155" x2="110" y2="194" pathLength="1" />
      <line class="flow" x1="84" y1="200" x2="110" y2="200" pathLength="1" />
      <line class="flow" x1="84" y1="245" x2="110" y2="206" pathLength="1" />
      {stages.map((x) => (
        <polyline class="flow" points={`${x + 20},194 ${x + 27},200 ${x + 20},206`} pathLength="1" />
      ))}
      <!-- flow: pipeline into app -->
      <line class="flow" x1="250" y1="200" x2="289" y2="200" pathLength="1" />
      <polyline class="flow" points="282,194 289,200 282,206" pathLength="1" />
      <!-- server slots, and the pipeline running on the server -->
      {slots.map((y) => <line class="text" x1="30" y1={y + 12} x2="70" y2={y + 12} pathLength="1" />)}
      <line class="flow" x1="100" y1="296" x2="126" y2="220" pathLength="1" />
      <!-- app contents -->
      <line class="text" x1="302" y1="101" x2="350" y2="101" pathLength="1" />
      <line class="header" x1="302" y1="135" x2="478" y2="135" pathLength="1" />
      {rows.map((y) => <line x1="302" y1={y} x2="478" y2={y} pathLength="1" />)}
      {cells.map((row, i) =>
        row.map(([a, b]) => (
          <line class="text" x1={a} y1={rows[i] + 12.5} x2={b} y2={rows[i] + 12.5} pathLength="1" />
        ))
      )}
    </g>

    <circle class="agent-halo" cx="200" cy="320" r="56" fill="url(#hero-glow)" />
    <circle class="agent" cx="200" cy="320" r="24" fill="url(#hero-orb)" />
    <circle class="fx-ring" cx="200" cy="320" r="24" />
    <g class="stroke links">
      <!-- the agent reads from the pipeline and acts in the app -->
      <line x1="185" y1="301" x2="180" y2="220" pathLength="1" />
      <line x1="223" y1="312" x2="290" y2="285" pathLength="1" />
    </g>

    <g class="stroke leaders">
      <polyline points="130,180 130,58 138,58" pathLength="1" />
      <polyline points="318,90 318,40 326,40" pathLength="1" />
      <polyline class="accent" points="215,339 240,372 250,372" pathLength="1" />
      <polyline points="68,368 68,392 76,392" pathLength="1" />
    </g>
    {slots.map((y, i) => <circle class:list={['led', { on: i === 1 }]} cx="104" cy={y + 12} r="3" />)}
    <circle class="dot" cx="130" cy="180" r="2.5" />
    <circle class="dot" cx="318" cy="90" r="2.5" />
    <circle class="dot accent" cx="200" cy="320" r="3" />
    <circle class="dot" cx="68" cy="368" r="2.5" />

    <!-- packets moving through the system (animated) -->
    {sourceRoutes.map((d) => <circle class="fx-source" r="2.5" data-route={d} />)}
    <circle class="fx-read" r="2.5" data-route={readRoute} />
    <circle class="fx-act" r="2.5" data-route={actRoute} />
  </svg>

  <span class="note note-pipeline">{pipeline}</span>
  <span class="note note-app">{app}</span>
  <span class="note note-agent">{agent}</span>
  <span class="note note-hosting">{hosting}</span>
</figure>

<script>
  import gsap from 'gsap';
  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';
  import { ScrambleTextPlugin } from 'gsap/ScrambleTextPlugin';

  gsap.registerPlugin(MotionPathPlugin, ScrambleTextPlugin);

  // Once the draw-in finishes, keep work moving through the diagram: data flows
  // from the sources into the app, the agent reads from the pipeline and acts in
  // the app, and the app updates one row per cycle.
  const CYCLE = 4;

  for (const drawing of document.querySelectorAll<HTMLElement>('.drawing')) {
    const q = gsap.utils.selector(drawing);
    const row = q('.fx-row')[0] as SVGRectElement;
    const rowYs: number[] = JSON.parse(row.dataset.rows!);

    // Show a packet, move it along its route, hide it again.
    const travel = (el: SVGElement, duration: number) =>
      gsap
        .timeline()
        .set(el, { opacity: 1 })
        .to(el, { duration, ease: 'power1.inOut', motionPath: { path: el.dataset.route! } })
        .set(el, { opacity: 0 });

    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      // Labels decode into place as they fade in with the CSS draw-in.
      q('.note').forEach((el, i) =>
        gsap.to(el, {
          delay: 1.85 + i * 0.1,
          duration: 0.8,
          scrambleText: { text: el.textContent!, chars: 'lowerCase', speed: 0.5 },
        })
      );

      // Starts just after the CSS draw-in (last label appears at ~2.25s).
      const tl = gsap.timeline({ delay: 2.3, repeat: -1 });

      rowYs.forEach((y, i) => {
        const cycle = gsap.timeline();
        q('.fx-source').forEach((el, j) => cycle.add(travel(el, 1.4), j * 0.2));
        cycle
          .add(travel(q('.fx-read')[0], 0.5), 1.1)
          .fromTo(q('.fx-ring'), { scale: 1, opacity: 0.7 },
            { scale: 1.6, opacity: 0, duration: 0.7, ease: 'power2.out', svgOrigin: '200 320', immediateRender: false }, 1.6)
          .add(travel(q('.fx-act')[0], 0.45), 1.8)
          .set(row, { attr: { y } }, 2.2)
          .to(row, { opacity: 1, duration: 0.25 }, 2.25)
          .to(row, { opacity: 0, duration: 0.5 }, 3.1);
        tl.add(cycle, i * CYCLE);
      });
      tl.add(() => {}, rowYs.length * CYCLE);

      // Don't spend frames on the loop while the hero is scrolled out of view.
      const observer = new IntersectionObserver(([entry]) => tl.paused(!entry.isIntersecting));
      observer.observe(drawing);
      return () => observer.disconnect();
    });
  }
</script>

<style>
  .drawing {
    position: relative;
    margin: 0;
    aspect-ratio: 520 / 420;
    width: 100%;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .stroke :global(*) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Boxes are white cards with a soft shadow on the grey canvas. */
  .frame :global(*) {
    stroke: var(--frame);
  }
  .frame rect {
    fill: var(--tile);
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.04)) drop-shadow(0 6px 14px rgb(0 0 0 / 0.06));
  }
  .content :global(*) {
    stroke: var(--rule);
  }
  .content .text {
    stroke-width: 4;
    stroke-linecap: round;
  }
  .content .header,
  .content .flow {
    stroke: var(--lead);
  }
  .links :global(*) {
    stroke: var(--accent);
  }
  .leaders :global(*) {
    stroke: var(--lead);
    stroke-width: 1;
  }
  .leaders .accent {
    stroke: var(--accent);
  }
  .dot {
    fill: var(--lead);
  }
  /* The centre of the agent orb. */
  .dot.accent {
    fill: #ffffff;
  }

  /* Labels are small pills at the end of their leader lines. */
  .note {
    position: absolute;
    transform: translateY(-50%);
    padding: 0.3em 0.75em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--ink);
    white-space: nowrap;
    background: var(--tile);
    border-radius: 999px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06), 0 2px 8px rgb(0 0 0 / 0.06);
  }
  .note-pipeline { left: 26.5%; top: 13.8%; }
  .note-app { left: 62.7%; top: 9.5%; }
  .note-agent { left: 48.1%; top: 88.6%; color: var(--accent); }
  .note-hosting { left: 14.6%; top: 93.3%; }

  /* Server status lights; the lit one blinks once the drawing is in. */
  .led { fill: var(--lead); }
  .led.on { fill: var(--accent); }

  /* One orchestrated draw-in on load: structure, then flow, then the agent and labels. */
  @media (prefers-reduced-motion: no-preference) {
    .stroke :global(*) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 0.8s cubic-bezier(0.6, 0, 0.2, 1) forwards;
    }
    .frame :global(*) { animation-delay: 0.1s; }
    .content :global(*) { animation-delay: 0.6s; animation-duration: 0.6s; }
    .links :global(*) { animation-delay: 1.35s; animation-duration: 0.4s; }
    .leaders :global(*) { animation-delay: 1.6s; animation-duration: 0.4s; }
    .frame rect {
      fill-opacity: 0;
      animation: draw 0.8s cubic-bezier(0.6, 0, 0.2, 1) forwards, fill-in 0.6s ease-out forwards;
      animation-delay: 0.1s, 0.4s;
    }
    .agent, .agent-halo, .dot, .note, .led {
      opacity: 0;
      animation: appear 0.4s ease-out forwards;
    }
    .agent, .agent-halo { animation-delay: 1.15s; }
    .dot, .led { animation-delay: 1.6s; }
    .led.on { animation: appear 0.4s ease-out 1.6s forwards, blink 2s ease-in-out 2.3s infinite; }
    .note { animation-delay: 1.85s; }
  }
  /* Flow animation elements stay hidden unless the script runs them. */
  .fx-row {
    fill: var(--wash);
    opacity: 0;
  }
  .fx-ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }
  [data-route] {
    fill: var(--accent);
    opacity: 0;
  }
  @keyframes appear { to { opacity: 1; } }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  @keyframes fill-in { to { fill-opacity: 1; } }
  /* Chrome cuts the end off dashed non-scaling strokes, so the dash is dropped
     once each stroke is drawn. */
  @keyframes draw {
    99% { stroke-dashoffset: 0; }
    to { stroke-dashoffset: 0; stroke-dasharray: none; }
  }

  @media (max-width: 30rem) {
    .note { font-size: 0.6875rem; }
  }
</style>
