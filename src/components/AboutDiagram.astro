---
// Small technical diagrams for the About chapters, drawn in the same style as
// the hero. Each one draws itself in when it scrolls into view, then loops a
// short animation of the idea it illustrates.
interface Props {
  kind: 'points' | 'steps' | 'review' | 'path';
  label: string;
  notes: Record<string, string>;
}
const { kind, label, notes } = Astro.props;

// Gradient ids for the agent orb and its glow; one diagram of each kind per page.
const orbId = `orb-${kind}`;
const glowId = `glow-${kind}`;
const orb = `url(#${orbId})`;
const glow = `url(#${glowId})`;

// steps: five stages of the work, each assisted by the agent below.
const stageW = 56;
const stageXs = [24, 98, 172, 246, 320];

// path: scattered raw data that the pipeline cleans up.
const raw = [[30, 86], [60, 102], [38, 126], [72, 146], [46, 168], [26, 150]];
const bars = [[288, 26], [308, 44], [328, 20]];

// points: the coins on the point card, and the three slots of the server.
const coins = [44, 58, 72, 86];
const slotYs = [80, 113, 146];
---

<figure class="about-diagram" data-kind={kind} aria-label={label}>
  <div class="canvas">
  <svg viewBox="0 0 400 260" aria-hidden="true">
    <defs>
      <linearGradient id={orbId} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#40a9ff" />
        <stop offset="1" stop-color="#5e5ce6" />
      </linearGradient>
      <radialGradient id={glowId}>
        <stop offset="0" stop-color="#0071e3" stop-opacity="0.28" />
        <stop offset="1" stop-color="#0071e3" stop-opacity="0" />
      </radialGradient>
    </defs>
    {kind === 'steps' && (
      <>
        <g class="stroke frame">
          {stageXs.map((x) => <rect x={x} y="70" width={stageW} height="56" rx="8" />)}
        </g>
        {stageXs.map((x) => <rect class="fx-flash" x={x} y="70" width={stageW} height="56" rx="8" />)}
        <g class="stroke content">
          {stageXs.map((x) => (
            <>
              <line class="text" x1={x + 8} y1="86" x2={x + 40} y2="86" />
              <line class="text" x1={x + 8} y1="110" x2={x + 30} y2="110" />
            </>
          ))}
          {stageXs.slice(1).map((x) => (
            <>
              <line class="flow" x1={x - 18} y1="98" x2={x} y2="98" />
              <polyline class="flow" points={`${x - 6},92 ${x},98 ${x - 6},104`} />
            </>
          ))}
        </g>
        <circle class="halo solid" cx="200" cy="200" r="46" fill={glow} />
        <circle class="agent solid" cx="200" cy="200" r="20" fill={orb} />
        <circle class="fx-ring" cx="200" cy="200" r="20" />
        <g class="stroke links">
          {stageXs.map((x) => <line x1="200" y1="180" x2={x + stageW / 2} y2="126" />)}
        </g>
        <g class="stroke leaders">
          <polyline class="accent" points="214,214 236,236 246,236" />
        </g>
        <circle class="dot accent solid" cx="200" cy="200" r="3" />
        {stageXs.map((x) => <circle class="fx-assist" r="2.5" data-route={`M200,180 L${x + stageW / 2},126`} />)}
        <circle class="fx-main" r="2.5" data-route="M24,98 H376" />
      </>
    )}

    {kind === 'review' && (
      <>
        <g class="stroke frame">
          <rect x="300" y="110" width="60" height="40" rx="6" />
          <circle cx="220" cy="62" r="9" />
          <path d="M204,92 C204,76 236,76 236,92" />
          <line x1="220" y1="100" x2="220" y2="160" />
        </g>
        <rect class="fx-flash" x="300" y="110" width="60" height="40" rx="6" />
        <g class="stroke content">
          <line class="text" x1="310" y1="124" x2="342" y2="124" />
          <line class="text" x1="310" y1="136" x2="334" y2="136" />
          <line class="flow" x1="80" y1="130" x2="300" y2="130" />
          <polyline class="flow" points="293,124 300,130 293,136" />
          <path class="flow" d="M220,160 V196 H60 V151" />
          <polyline class="flow" points="54,158 60,151 66,158" />
        </g>
        <circle class="halo solid" cx="60" cy="130" r="46" fill={glow} />
        <circle class="agent solid" cx="60" cy="130" r="20" fill={orb} />
        <circle class="fx-ring" cx="60" cy="130" r="20" />
        <g class="stroke leaders">
          <polyline class="accent" points="60,110 60,64 68,64" />
          <polyline points="330,150 330,178 338,178" />
        </g>
        <circle class="dot accent solid" cx="60" cy="130" r="3" />
        <circle class="dot solid" cx="330" cy="150" r="2.5" />
        <polyline class="fx-check" points="230,116 236,122 247,109" />
        <path class="fx-cross" d="M231,109 L245,123 M245,109 L231,123" />
        <circle class="fx-item" r="2.5" />
        <circle class="fx-item" r="2.5" />
        <circle class="fx-item" r="2.5" />
      </>
    )}

    {kind === 'path' && (
      <>
        <g class="stroke frame">
          <polyline points="92,70 140,112 140,148 92,190" />
          <rect x="270" y="70" width="110" height="120" rx="8" />
          <line x1="270" y1="88" x2="380" y2="88" />
        </g>
        <g class="stroke content">
          <line class="flow" x1="140" y1="130" x2="190" y2="130" />
          <polyline class="flow" points="183,124 190,130 183,136" />
          <line class="flow" x1="230" y1="130" x2="270" y2="130" />
          <polyline class="flow" points="263,124 270,130 263,136" />
          <line class="header" x1="282" y1="176" x2="368" y2="176" />
          <path class="flow" d="M325,190 V214 H210 V151" />
          <polyline class="flow" points="204,158 210,151 216,158" />
        </g>
        {raw.map(([x, y]) => <circle class="raw solid" cx={x} cy={y} r="2.5" />)}
        {bars.map(([x, h]) => <rect class="bar solid" x={x} y={176 - h} width="12" height={h} rx="2" />)}
        <rect class="fx-bar solid" x="348" y="140" width="12" height="36" rx="2" fill={orb} />
        <circle class="halo solid" cx="210" cy="130" r="46" fill={glow} />
        <circle class="agent solid" cx="210" cy="130" r="20" fill={orb} />
        <circle class="fx-ring" cx="210" cy="130" r="20" />
        <g class="stroke leaders">
          <polyline class="accent" points="210,110 210,54 218,54" />
        </g>
        <circle class="dot accent solid" cx="210" cy="130" r="3" />
        {raw.map(([x, y]) => <circle class="fx-raw" r="2.5" data-route={`M${x},${y} L140,130 H190`} />)}
        <circle class="fx-out" r="2.5" data-route="M230,130 H270" />
        <circle class="fx-steer" r="2.5" data-route="M325,190 V214 H210 V151" />
      </>
    )}

    {kind === 'points' && (
      <>
        <g class="stroke frame">
          <rect x="24" y="96" width="88" height="56" rx="8" />
          <circle cx="200" cy="104" r="10" />
          <path d="M180,142 C180,120 220,120 220,142" />
          <rect x="288" y="80" width="88" height="100" rx="8" />
          {slotYs.slice(1).map((y) => <line x1="288" y1={y} x2="376" y2={y} />)}
        </g>
        <rect class="fx-flash" x="289" y="114" width="86" height="31" />
        <g class="stroke content">
          <line class="text" x1="36" y1="112" x2="76" y2="112" />
          {slotYs.map((y) => <line class="text" x1="300" y1={y + 16.5} x2="336" y2={y + 16.5} />)}
          <line class="flow" x1="112" y1="124" x2="174" y2="124" />
          <polyline class="flow" points="167,118 174,124 167,130" />
          <line class="flow" x1="226" y1="124" x2="288" y2="124" />
          <polyline class="flow" points="281,118 288,124 281,130" />
          <path class="flow" d="M200,148 V196 H68 V154" />
          <polyline class="flow" points="62,161 68,154 74,161" />
        </g>
        {coins.map((x) => <circle class="coin solid" cx={x} cy="136" r="4" fill={orb} />)}
        {slotYs.map((y) => <circle class="dot solid" cx="362" cy={y + 16.5} r="2.5" />)}
        <circle class="fx-led" cx="362" cy="129.5" r="2.5" />
        <circle class="fx-ring" cx="200" cy="104" r="10" />
        <g class="stroke leaders">
          <polyline points="200,94 200,60 208,60" />
          <polyline points="332,180 332,224 324,224" />
        </g>
        {coins.map((x) => <circle class="fx-coin" r="2.5" data-route={`M${x},136 L112,124 H174`} />)}
        <circle class="fx-talk" r="2.5" data-route="M200,148 V196 H68 V154" />
        <circle class="fx-talk" r="2.5" data-route="M68,154 V196 H200 V148" />
        <circle class="fx-out" r="2.5" data-route="M226,124 H288" />
      </>
    )}
  </svg>

  {Object.entries(notes).map(([key, text]) => (
    <span class={`note note-${kind}-${key}`}>{text}</span>
  ))}
  </div>
</figure>

<script>
  import gsap from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';
  import { ScrambleTextPlugin } from 'gsap/ScrambleTextPlugin';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(DrawSVGPlugin, MotionPathPlugin, ScrambleTextPlugin, ScrollTrigger);

  type Q = (selector: string) => Element[];

  // Show a packet, move it along a route, hide it again.
  const travel = (el: Element, duration: number, ease = 'power1.inOut') =>
    gsap
      .timeline()
      .set(el, { opacity: 1 })
      .to(el, { duration, ease, motionPath: { path: (el as SVGElement).dataset.route! } })
      .set(el, { opacity: 0 });

  const pulse = (ring: Element) =>
    gsap.fromTo(ring, { scale: 1, opacity: 0.7 },
      { scale: 1.6, opacity: 0, duration: 0.7, ease: 'power2.out', transformOrigin: '50% 50%', immediateRender: false });

  const flash = (el: Element, hold = 0.3) =>
    gsap.timeline().to(el, { opacity: 1, duration: 0.2 }).to(el, { opacity: 0, duration: 0.5 }, `+=${hold}`);

  // One looping timeline per diagram, built paused.
  const loops: Record<string, (q: Q) => gsap.core.Timeline> = {
    // A piece of work crosses the five stages; the agent assists as it reaches each one.
    steps(q) {
      const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.6, paused: true });
      const ring = q('.fx-ring')[0];
      const start = 0.5, duration = 3.2;
      tl.add(travel(q('.fx-main')[0], duration, 'none'), start);
      q('.fx-assist').forEach((el, i) => {
        // When the packet reaches the middle of stage i.
        const at = start + ((28 + 74 * i) / 352) * duration;
        tl.add(pulse(ring), at - 0.45).add(travel(el, 0.35), at - 0.35).add(flash(q('.fx-flash')[i]), at);
      });
      return tl;
    },

    // Drafts leave the agent and stop at the reviewer: two ship, one goes back.
    review(q) {
      const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.4, paused: true });
      const ring = q('.fx-ring')[0];
      const outcomes = [true, false, true];
      q('.fx-item').forEach((el, i) => {
        const pass = outcomes[i];
        const item = gsap
          .timeline()
          .add(pulse(ring))
          .set(el, { opacity: 1 })
          .to(el, { duration: 0.8, ease: 'power1.inOut', motionPath: { path: 'M80,130 H220' } })
          .add(flash(q(pass ? '.fx-check' : '.fx-cross')[0], 0.4))
          .to(el, pass
            ? { duration: 0.6, ease: 'power1.inOut', motionPath: { path: 'M220,130 H318' } }
            : { duration: 1.3, ease: 'power1.inOut', motionPath: { path: 'M220,130 V196 H60 V151' } }, '+=0.35')
          .set(el, { opacity: 0 });
        if (pass) item.add(flash(q('.fx-flash')[0], 0.2), '-=0.05');
        tl.add(item, i * 1.7);
      });
      return tl;
    },

    // Raw data funnels into the agent, its output updates the app, and people
    // steer the agent from the app.
    path(q) {
      const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.5, paused: true });
      const ring = q('.fx-ring')[0];
      q('.fx-raw').forEach((el, i) => tl.add(travel(el, 1), i * 0.12));
      tl.add(pulse(ring), 1.6)
        .add(travel(q('.fx-out')[0], 0.4), 1.75)
        // Grow from the baseline (y + height = 176).
        .fromTo(q('.fx-bar'), { attr: { y: 163, height: 13 } },
          { attr: { y: 140, height: 36 }, duration: 0.6, ease: 'back.out(2)', immediateRender: false }, 2.1)
        .add(travel(q('.fx-steer')[0], 1.1), 2.7)
        .add(pulse(ring), 3.75);
      return tl;
    },

    // Points leave the card for the engineer, who talks it through with you and
    // then delivers the work to your server. The card refills for the next loop.
    points(q) {
      const tl = gsap.timeline({ repeat: -1, repeatDelay: 0.6, paused: true });
      const ring = q('.fx-ring')[0];
      const coins = q('.coin');
      q('.fx-coin').forEach((el, i) =>
        tl.to(coins[i], { opacity: 0.25, duration: 0.2 }, i * 0.25).add(travel(el, 0.7), i * 0.25));
      tl.add(pulse(ring), 1.5);
      const [ask, answer] = q('.fx-talk');
      tl.add(travel(ask, 1.1), 1.7).add(travel(answer, 1.1), 2.9).add(pulse(ring), 4);
      tl.add(travel(q('.fx-out')[0], 0.5), 4.2)
        .add(flash(q('.fx-flash')[0], 0.6), 4.7)
        .to(q('.fx-led'), { opacity: 1, duration: 0.2 }, 4.7)
        .to(q('.fx-led'), { opacity: 0, duration: 0.5 }, 5.7)
        .to(coins, { opacity: 1, duration: 0.5, stagger: 0.08 }, 5.9);
      return tl;
    },
  };

  // On wide screens the page stages the About section: the diagrams stack in one
  // sticky column beside the chapters (the page's `.staged` styles), and the one
  // for the chapter in the middle of the screen is shown.
  const conditions = { motion: '(prefers-reduced-motion: no-preference)', wide: '(min-width: 56.0625rem)' };

  gsap.matchMedia().add(conditions, (context) => {
    const { motion, wide } = context.conditions!;
    if (!motion) return;

    const figures = [...document.querySelectorAll<HTMLElement>('.about-diagram')];
    const chapters = figures[0]?.closest('.chapters');
    const staged = wide && !!chapters;
    const intros = new Map<HTMLElement, gsap.core.Timeline>();
    const show = (figure: HTMLElement) => {
      figures.forEach((f) => f.classList.toggle('is-active', f === figure));
      intros.get(figure)?.play();
    };
    if (staged) chapters!.classList.add('staged');

    figures.forEach((figure, i) => {
      const q = gsap.utils.selector(figure);
      const notes = q('.note');
      const loop = loops[figure.dataset.kind!](q);

      // Hidden until the diagram scrolls into view, then drawn like the hero:
      // structure, contents, the agent, its links and finally the labels.
      gsap.set(q('.stroke > *'), { drawSVG: '0%' });
      gsap.set(q('.frame > rect'), { fillOpacity: 0 });
      gsap.set([...q('.solid'), ...notes], { opacity: 0 });
      const draw = (duration: number) =>
        ({ drawSVG: '100%', duration, ease: 'power2.inOut', stagger: { amount: 0.25 } });
      const intro = gsap
        .timeline({ paused: true, onComplete: () => trigger.isActive && loop.play() })
        .to(q('.frame > *'), draw(0.8))
        .to(q('.frame > rect'), { fillOpacity: 1, duration: 0.6, ease: 'power1.out' }, 0.3)
        .to(q('.content > *'), draw(0.6), '-=0.35')
        .to(q('.solid'), { opacity: 1, duration: 0.4, ease: 'power1.out' }, '-=0.2')
        .to(q('.links > *'), draw(0.4), '-=0.1')
        .to(q('.leaders > *'), draw(0.4), '-=0.1');
      notes.forEach((el, i) =>
        intro
          .set(el, { opacity: 1 }, `<${i ? 0.1 : 0.2}`)
          .to(el, { duration: 0.8, scrambleText: { text: el.textContent!, chars: 'lowerCase', speed: 0.5 } }, '<'));
      intros.set(figure, intro);

      // Draw in once; after that, only run the loop while the diagram is on
      // screen, or, when staged, while its chapter is. A staged diagram stays
      // shown until another chapter takes over, even after a fast scroll jumps
      // past its whole chapter.
      const text = figure.closest('.chapter')?.querySelector('.chapter-text');
      const trigger = ScrollTrigger.create({
        trigger: staged && text ? text : figure,
        start: staged ? 'top 60%' : 'top 80%',
        end: staged ? 'bottom 60%' : 'bottom top',
        onToggle: (self) => {
          if (self.isActive) intro.play();
          if (intro.progress() === 1) loop.paused(!self.isActive);
        },
        onEnter: () => staged && show(figure),
        onEnterBack: () => staged && show(figure),
        onLeaveBack: () => staged && i > 0 && show(figures[i - 1]),
      });
    });
    if (staged) figures[0].classList.add('is-active');

    return () => {
      chapters?.classList.remove('staged');
      figures.forEach((f) => f.classList.remove('is-active'));
    };
  });
</script>

<style>
  /* Each diagram sits on a white card; labels are placed on the inner canvas. */
  .about-diagram {
    margin: 0;
    width: 100%;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: var(--tile);
    border-radius: 1.5rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 12px 32px rgb(0 0 0 / 0.06);
  }
  .canvas {
    position: relative;
    aspect-ratio: 400 / 260;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .stroke :global(*) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .frame :global(*) {
    stroke: var(--frame);
  }
  /* Boxes are light-grey cards on the white canvas. */
  .frame rect {
    fill: var(--surface);
  }
  .frame .boundary {
    fill: none;
    stroke: var(--rule);
  }
  .content :global(*) {
    stroke: var(--rule);
  }
  .content .text {
    stroke-width: 4;
    stroke-linecap: round;
  }
  .content .header,
  .content .flow {
    stroke: var(--lead);
  }
  .links :global(*) {
    stroke: var(--accent);
  }
  .leaders :global(*) {
    stroke: var(--lead);
    stroke-width: 1;
  }
  .leaders .accent {
    stroke: var(--accent);
  }
  .dot,
  .raw {
    fill: var(--lead);
  }
  /* The centre of the agent orb. */
  .dot.accent {
    fill: #ffffff;
  }
  .bar {
    fill: var(--rule);
  }

  .note {
    position: absolute;
    transform: translateY(-50%);
    padding: 0.3em 0.75em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--ink);
    white-space: nowrap;
    background: var(--tile);
    border-radius: 999px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06), 0 2px 8px rgb(0 0 0 / 0.06);
  }
  /* Positions are the label anchor points in SVG units, as % of 400 × 260. */
  .note-steps-code { left: 6%; top: 20.8%; }
  .note-steps-review { left: 24.5%; top: 20.8%; }
  .note-steps-tests { left: 43%; top: 20.8%; }
  .note-steps-docs { left: 61.5%; top: 20.8%; }
  .note-steps-deploy { left: 80%; top: 20.8%; }
  .note-steps-agent { left: 61.5%; top: 90.8%; color: var(--accent); }
  .note-review-agent { left: 17%; top: 24.6%; color: var(--accent); }
  .note-review-person { left: 62%; top: 23.8%; }
  .note-review-ship { left: 84.5%; top: 68.5%; }
  .note-review-back { left: 22%; top: 83%; color: var(--lead); }
  .note-path-pipeline { left: 23%; top: 20.8%; }
  .note-path-agent { left: 54.5%; top: 20.8%; color: var(--accent); }
  .note-path-app { left: 68.5%; top: 30.4%; }
  .note-path-steer { left: 56%; top: 88.5%; color: var(--lead); }
  .note-points-card { left: 6%; top: 29%; }
  .note-points-person { left: 52%; top: 23.1%; }
  .note-points-talk { left: 22%; top: 75.4%; color: var(--lead); }
  /* Anchored by its right edge, at the end of a leader that points left. */
  .note-points-server { right: 19%; top: 86.2%; }

  /* Animation elements stay hidden unless the script runs them. */
  .fx-flash {
    fill: var(--wash);
    opacity: 0;
  }
  .fx-ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }
  .fx-check,
  .fx-cross {
    fill: none;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }
  .fx-check { stroke: var(--accent); }
  .fx-cross { stroke: var(--lead); }
  .fx-led,
  [data-route],
  .fx-item {
    fill: var(--accent);
    opacity: 0;
  }

  @media (max-width: 30rem) {
    .note { font-size: 0.6875rem; }
  }
</style>
