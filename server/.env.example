# Copy to .env and fill in. Never commit .env.

# Where the service listens. Caddy proxies api.lulolo.com to this address.
HOST=127.0.0.1
PORT=8787

# Sites allowed to post the form, comma-separated.
ALLOWED_ORIGINS=https://www.lulolo.com,https://lulolo.com

# SMTP account that sends the notifications. These are Alibaba Mail's
# settings, which host info@lulolo.com. Use the mailbox password, or an app
# password if the mailbox has one set up. Leave SMTP_HOST empty to print
# emails to the console instead of sending them.
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USER=info@lulolo.com
SMTP_PASS=

# Sender and recipient of each notification. Replies go to the visitor.
MAIL_FROM=info@lulolo.com
MAIL_TO=info@lulolo.com
